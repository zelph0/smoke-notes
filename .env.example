# Reference for .env.local. `pnpm db:env` writes .env.local for you from the Neon CLI
# (after `pnpm exec neon login`); you never paste secrets by hand. Never commit .env*.local.
# Validated by src/env.ts: the build fails when a required value is missing.

# --- Database (Neon "dev" branch) -------------------------------------------------
# Pooled URL (host contains -pooler): used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct URL: used only by the Prisma CLI (migrations, seed).
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth (Neon Auth) --------------------------------------------- @auth-module:start
# Per-branch Neon Auth endpoint: `neon neon-auth status --branch dev`.
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth"
# At least 32 chars: `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=""
# Optional branded auth emails via Resend. Empty -> Neon's shared sender.
RESEND_API_KEY=""
EMAIL_FROM=""
# Seeded demo user's email (use your own to see seeded tasks after signing in with it).
SEED_USER_EMAIL=""
# ------------------------------------------------------------------ @auth-module:end

# --- App ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Sentry (optional: empty = disabled) -------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
