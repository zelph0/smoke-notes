{
  "name": "app-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:env": "tsx scripts/dev-env.ts",
    "db:test": "tsx scripts/test-db.ts",
    "template:sync": "tsx scripts/sync-template-config.ts",
    "template:check": "tsx scripts/sync-template-config.ts --check",
    "style:check": "playwright test -c playwright.style.config.ts",
    "style:reset": "tsx scripts/style-candidates.ts",
    "auth:remove": "tsx scripts/remove-auth.ts",
    "provision": "tsx scripts/provision.ts",
    "deprovision": "tsx scripts/deprovision.ts",
    "skill:link": "tsx scripts/link-skill.ts",
    "vercel-build": "tsx scripts/vercel-build.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@neon/auth": "0.8.2",
    "@neondatabase/serverless": "1.2.1",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/nextjs": "11.17.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.78.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.39.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "dotenv": "18.0.10",
    "jsdom": "29.1.1",
    "neon": "9.9.4",
    "prisma": "7.10.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vercel": "66.6.0",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24 <25"
  }
}
